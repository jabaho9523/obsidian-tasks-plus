{
	"name": "tasks-plus",
	"version": "0.2.1",
	"description": "The calm GTD app over plain markdown. Six fixed views — Inbox, Today, Upcoming, Anytime, Someday, Logbook — quick capture with natural-language dates, and your tasks stay ordinary checkboxes in your notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=test/build --log-level=warning && node --test \"test/build/*.js\""
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"obsidian-md",
		"tasks",
		"gtd",
		"todo",
		"task-management",
		"quick-capture",
		"productivity",
		"pkm",
		"knowledge-management",
		"note-taking"
	],
	"author": "Jacob Holm",
	"license": "0BSD",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "^16.11.6",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "17.14.0",
		"jiti": "2.7.0",
		"obsidian": "^1.14.4",
		"tslib": "2.9.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.73.0"
	}
}
